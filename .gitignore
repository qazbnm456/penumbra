# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# uv / virtualenv
.venv/

# Run artifacts (traces, persisted orbits, and the Tier 0 Horizon a live run writes; not source).
# /horizon/ holds index.db and one JSON file per captured node — a user's whole capture history, so
# committing it would publish everything they ever threw in. The settings
# page writes orbits/.settings — inside an already-ignored directory, and deliberately NOT a
# .json file, since list_orbit_summaries globs orbits/*.json (which pathlib matches against
# dotfiles too) and would report it as a corrupt orbit.
/traces/
/orbits/
/horizon/
# The same data under its pre-rename names, until `penumbra.legacy` moves it on the next start.
/notebooks/
/inbox/
*.jsonl

# Secrets / local env (only .env.example is tracked)
.env

# Local research/design notes that fed into AGENTS.md/CHANGELOG.md's durable invariants and
# decisions — not tracked, per the same reasoning as not publishing raw design-debate transcripts:
# the resolved "what and why" belongs in AGENTS.md/CHANGELOG.md, not the working notes that
# produced it.
#
# `docs/invariants/` is the ONE exception and IS tracked: it holds the argument behind each
# indexed invariant, which is durable by definition. Note the shape — `/docs/*` excludes the
# CONTENTS, where `/docs/` would exclude the directory itself and stop git ever descending into
# it, which makes the negation below silently dead. Verified in a scratch repo, not assumed.
/docs/*
!/docs/invariants/

# macOS
.DS_Store

# Claude Code local overrides (never commit)
.claude/settings.local.json
.claude/scheduled_tasks.lock


# Coverage data — a local run artifact, never source.
.coverage

# Desktop shell build output. `runtime/` is assembled by desktop/scripts/build_runtime.py (a whole
# Python plus deno, hundreds of MB) and `gen/` is regenerated by the Tauri CLI on every build.
/desktop/src-tauri/target/
/desktop/src-tauri/gen/
/desktop/src-tauri/runtime/*
!/desktop/src-tauri/runtime/.keep
