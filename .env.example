# Every PN_* setting Penumbra reads, with its default and when you would change it.
#
# In the DESKTOP APP, settings go in `penumbra.env` in the app's data folder: choose File > Open
# Configuration File… (or right-click the island), which creates it from a shorter template, then
# File > Restart Server. The names below are the same.
#
# From a SOURCE INSTALL (`penumbra serve`, the CLI, the container), copy this file to `.env` and fill
# it in. Nothing loads it automatically: source it yourself (`set -a; . ./.env; set +a`), export the
# variables, or pass `--env-file .env` to docker.
#
# A commented line shows the default. Remove the # to change it.

# --- The model (required to ask, summarise or generate anything) --------------------------------

# The model every run uses, as the provider-prefixed id litellm expects, for example
# openai/gpt-4o or anthropic/claude-sonnet-5.
PN_MAIN_MODEL=

# A separate model for the sub-calls a run makes while reading. Unset, it is PN_MAIN_MODEL.
# PN_SUB_MODEL=

# The API key for the provider PN_MAIN_MODEL names, and an OpenAI-compatible endpoint if you use a
# proxy (then write the plain model ids it serves).
PN_API_KEY=
# PN_BASE_URL=https://your-endpoint/v1

# Run a role on your Claude Pro or Max subscription instead of an API key, by prefixing its model
# with `claude-agent-sdk/`. It needs Claude Code installed and logged in (run `claude` once in a
# terminal); a source install also needs `uv sync --extra subscription`. A role on
# this path ignores PN_API_KEY and PN_BASE_URL, so one role can use the subscription and the other
# a proxy. It refuses to start while ANTHROPIC_API_KEY is set, because the Claude Code CLI would use
# that key and bill API credit instead (invariant 35).
# PN_MAIN_MODEL=claude-agent-sdk/claude-sonnet-5
# PN_SUB_MODEL=claude-agent-sdk/claude-fable-5

# --- Budgets for one run ------------------------------------------------------------------------
#
# The defaults were measured, not guessed (invariant 59). Change one only when an error names it.

# How many reasoning steps and model calls one run may take. A run reads its sources a piece at a
# time and each look costs a step, so 25 leaves room; the wall-clock limit below stops a runaway.
# PN_MAX_ITERATIONS=25
# PN_MAX_LLM_CALLS=30

# How many times a failed run is tried again. A retry rarely fixes a failure that repeats, and it
# spends the budget again.
# PN_MAX_RETRIES=1

# The longest reply one model call may write. A reasoning model's thinking counts against this cap
# without appearing in the reply, so a small cap returns a reply cut off halfway. Lower it only if
# your model refuses the length.
# PN_MAX_TOKENS=32768

# How much of what a run prints while reading is shown back to the model before it is shortened.
# PN_MAX_OUTPUT_CHARS=40000
# PN_ADAPTER=json

# Seconds one run may take before it is stopped. Unset, it is 300, or 1800 when PN_MAIN_MODEL is on
# the subscription path, which is much slower per call. A podcast gets a multiple of it: 1x for
# short, 2x for the default length and 5x for long (invariant 68). The CLI ignores it.
# PN_RUN_TIMEOUT_SECONDS=300

# The most text one run reads at once, in characters (invariant 8). An orbit past it refuses to run
# rather than running slowly. A malformed value stops the server from starting.
# PN_MAX_CORPUS_CHARS=8000000

# --- Summaries and the Horizon ------------------------------------------------------------------

# Whether a new capture is summarised without being asked. Off by default, because every summary is
# a model call on your key and importing 200 bookmarks should not spend 200 calls (invariant 80).
# The settings page has this switch; set here, it wins and the page shows it locked.
# PN_AUTO_DISTIL=on

# The most captures one automatic pass may summarise. A bound on spending, so it is never on the
# settings page (invariant 41). A malformed value stops the server from starting.
# PN_AUTO_DISTIL_MAX_PER_BATCH=20

# Where a new capture is filed once it is read, besides the Horizon. Unset, it goes into a first
# orbit created for it; `off` files it nowhere; an orbit id files it there. The settings page's
# "Where new captures land" sets the same thing; set here, this wins.
# PN_LANDING_ORBIT=off

# How much one question over the Horizon, a tag or an entity may read: at most this many characters
# and this many captures, picked locally before any model call. Never more than PN_MAX_CORPUS_CHARS.
# PN_HORIZON_ASK_CHARS=1000000
# PN_HORIZON_ASK_ITEMS=40

# The largest file one upload may be, in bytes, to an orbit or to the Horizon (invariant 30).
# PN_MAX_UPLOAD_BYTES=50000000

# --- Language -----------------------------------------------------------------------------------

# The language everything the model writes is in: answers, guides, titles and the podcast. Unset,
# each orbit picks one from your interface language, your system or browser language, its sources
# and the questions asked in it (invariant 39). Set, it applies everywhere. Citations are never
# translated, because they have to match the source. The settings page has this too; set here, it
# wins and the page shows it locked.
# PN_OUTPUT_LANGUAGE=Traditional Chinese

# --- The podcast --------------------------------------------------------------------------------

# Which voice provider reads the podcast. "edge-tts" needs no key and no download, but uses an
# undocumented Microsoft service. "chatterbox" runs fully on your machine with no network, is about
# 30 times slower (a 3.4-minute episode took 16 minutes on Apple Silicon), writes WAV instead of MP3,
# and needs `uv sync --extra chatterbox` (about 1 GB), so it is source install only (invariant 43).
# PN_TTS_PROVIDER=edge-tts

# The two hosts' voices. Unset, the podcast's language picks them. For edge-tts these are voice ids
# (`edge-tts --list-voices` lists them). For chatterbox they are "host-a" and "host-b" (the clips in
# penumbra/voices/), "built-in", or an absolute path to your own reference `.wav` file, which only works
# here and never from the settings page. The settings page sets the voices too; set here, these win.
# PN_TTS_VOICE_HOST_A=en-US-GuyNeural
# PN_TTS_VOICE_HOST_B=en-US-JennyNeural

# --- Network ------------------------------------------------------------------------------------

# Behind a fake-IP proxy or VPN (Clash, Mihomo, Surge), every public hostname resolves into a
# reserved range, the fetcher refuses it as unsafe, and every link fails with "resolves to a
# disallowed address". List the range your proxy uses here; 198.18.0.0/15 covers Clash's default
# (/16) and Surge's. A range that overlaps loopback, cloud metadata, private networks or multicast
# is refused, and so is a typo, because those would switch the protection off (invariant 76).
# PN_FETCH_ALLOW_CIDRS=198.18.0.0/15

# Host names the server accepts besides IP addresses and `localhost`, comma-separated. Other names
# are refused to stop DNS rebinding. Set it only for a name that is really yours, such as an mDNS
# `something.local` (invariant 77).
# PN_ALLOWED_HOSTS=orbit.local

# --- The API token ------------------------------------------------------------------------------

# Every request needs this token except the web page's own files (invariant 77). Unset, the server
# makes a new one at every start and prints it. Set it when something has to know it in advance,
# such as a container or a proxy; the desktop app sets it for you. A blank value does not turn the
# token off, and nothing can.
# PN_API_TOKEN=

# --- Housekeeping -------------------------------------------------------------------------------

# How long reasoning traces (traces/*.jsonl) are kept, by age in days and by count. A trace can hold
# the full text of your sources, so they are not kept forever. 0 turns that limit off. A running
# run's trace and anything from the last hour are always kept. A malformed value stops the server
# from starting.
# PN_TRACE_RETENTION_DAYS=7
# PN_MAX_TRACE_FILES=500

# --- Fixed on purpose ---------------------------------------------------------------------------

# Where scanned PDF pages are read: "local" (RapidOCR, with Tesseract as a fallback) is the only one
# built (invariant 7).
# PN_OCR_PROVIDER=local

# The sandbox every run executes in. Only "pyodide" is allowed; any other value refuses to start
# rather than being quietly corrected (invariant 9).
# PN_INTERPRETER=pyodide

# For developers: most of these are read by `PenumbraConfig.from_env` in `penumbra/config.py`, which
# refuses to start without PN_MAIN_MODEL. The ones a server with no model must still honour
# (uploads, the Horizon, traces, settings, the network guard) have readers of their own in
# `config.py`, and PN_API_TOKEN and PN_ALLOWED_HOSTS are read in `auth.py`. Penumbra passes these
# values to rlm-harness itself and does not read rlm-harness's RLM_* variables. PN_EXIT_WITH_PARENT
# is set by the desktop app for the server it starts (invariant 81) and is not meant to be set by hand.
